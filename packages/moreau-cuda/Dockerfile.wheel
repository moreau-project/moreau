# Dockerfile.wheel - Build manylinux-compatible GPU wheels
#
# Usage:
#   # Default (CUDA 12.2):
#   docker build -f packages/moreau-cuda/Dockerfile.wheel -t moreau-cuda-wheel .
#
#   # Specific CUDA version:
#   docker build -f packages/moreau-cuda/Dockerfile.wheel \
#     --build-arg CUDA_VERSION=12.2 \
#     --build-arg CUDA_SHORT=cu122 \
#     --build-arg CUDSS_SUFFIX=cuda12 \
#     --build-arg PYTORCH_INDEX=cu121 \
#     -t moreau-cuda-wheel .
#
#   docker run --rm -v $(pwd)/dist:/output moreau-cuda-wheel bash -c "cp /workspace/packages/moreau-cuda/dist/*.whl /output/"
#
# Note: Uses Python 3.12 by default. The wheel uses stable ABI (abi3-py312) and works on Python 3.12+.

# Architecture parameters (declared before FROM so they're usable in the
# manylinux image tag). Defaults preserve the historical x86_64 behavior.
ARG ARCH=x86_64
# NVIDIA uses "sbsa" in redist paths for aarch64 server SoCs (Grace, Ampere
# Altra, AWS Graviton). Override to "sbsa" when ARCH=aarch64.
ARG CUDA_ARCH_LABEL=x86_64

# Use manylinux_2_28 (AlmaLinux 8, glibc 2.28) as build base.
# NVIDIA libs (cusolver, cusparse, cudss) are excluded from the wheel and
# provided at runtime via nvidia-* PyPI packages.
FROM quay.io/pypa/manylinux_2_28_${ARCH} AS builder

# Re-declare build args inside the stage (ARG before FROM doesn't leak in).
ARG ARCH
ARG CUDA_ARCH_LABEL
ARG PYTHON_VERSION=3.12
ARG CUDSS_VERSION=0.8.0.10
# CUDA version parameters
ARG CUDA_VERSION=12.2
ARG CUDA_SHORT=cu122
ARG CUDA_MAJOR=12
ARG CUDSS_SUFFIX=cuda12
ARG PYTORCH_INDEX=cu121
# GCC toolset version: CUDA 12.2 requires GCC <=12, CUDA 13+ supports GCC 13
ARG GCC_TOOLSET=12

# Compute CUDA toolkit package name (e.g., cuda-toolkit-12-2)
# CUDA_VERSION format: "12.2" -> "12-2"
ARG CUDA_TOOLKIT_PKG=cuda-toolkit-${CUDA_VERSION/./-}

# Install GCC toolset (CUDA 12.2 requires GCC <=12, CUDA 13+ supports GCC 13)
RUN dnf install -y gcc-toolset-${GCC_TOOLSET}-gcc gcc-toolset-${GCC_TOOLSET}-gcc-c++ gcc-toolset-${GCC_TOOLSET}-libstdc++-devel suitesparse-devel && \
    dnf clean all

# Install CUDA toolkit and build dependencies (AlmaLinux 8 uses dnf/rhel8 repo).
# NVIDIA hosts separate per-arch repos under rhel8/<x86_64|sbsa>/.
RUN dnf install -y dnf-plugins-core && \
    dnf config-manager --add-repo https://developer.download.nvidia.com/compute/cuda/repos/rhel8/${CUDA_ARCH_LABEL}/cuda-rhel8.repo && \
    dnf install -y ${CUDA_TOOLKIT_PKG} && \
    dnf clean all

# Set GCC as the default compiler for CUDA compatibility
ENV PATH="/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/lib64:/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/lib:${LD_LIBRARY_PATH}"
ENV CC="/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin/gcc"
ENV CXX="/opt/rh/gcc-toolset-${GCC_TOOLSET}/root/usr/bin/g++"

# Install GTest (required for CMake build)
WORKDIR /tmp
RUN curl -sL -o googletest-1.14.0.tar.gz https://github.com/google/googletest/archive/refs/tags/v1.14.0.tar.gz && \
    echo "8ad598c73ad796e0d8280b082cebd82a630d73e73cd3c70057938a6501bba5d7  googletest-1.14.0.tar.gz" | sha256sum -c - && \
    tar -xzf googletest-1.14.0.tar.gz && \
    cd googletest-1.14.0 && \
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build build -j4 && \
    cmake --install build && \
    cd / && rm -rf /tmp/googletest-1.14.0 /tmp/googletest-1.14.0.tar.gz

# Set CUDA paths - use symlink /usr/local/cuda which points to installed version
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
ENV CUDA_HOME="/usr/local/cuda"

# Download and install cuDSS (needed at compile time; runtime via nvidia-cudss PyPI package)
# CUDSS_SUFFIX is "cuda12" for CUDA 12.x, "cuda13" for CUDA 13.x.
# Redist path uses linux-<x86_64|sbsa>/ mirroring the CUDA repo layout.
WORKDIR /opt
RUN CUDSS_TARBALL="libcudss-linux-${CUDA_ARCH_LABEL}-${CUDSS_VERSION}_${CUDSS_SUFFIX}-archive.tar.xz" && \
    case "${CUDSS_VERSION}-${CUDA_ARCH_LABEL}-${CUDSS_SUFFIX}" in \
        0.8.0.10-x86_64-cuda12) CUDSS_SHA256="29716a05c64b28531309afcb7a9dd5044081a43197e72bdd0fbf29e9b4ee4707" ;; \
        0.8.0.10-x86_64-cuda13) CUDSS_SHA256="ba18f5fd80dcbbe905d158caac5b3061d848442bb5abd477b5f296b4257a4937" ;; \
        0.8.0.10-sbsa-cuda12)   CUDSS_SHA256="949426015c986897df7677435b450d2740e8849d16b07cdc13db27ea32ebb18b" ;; \
        0.8.0.10-sbsa-cuda13)   CUDSS_SHA256="c5fe7e5796792e10c3c5971bbb169ab3040ba61fe6fc99bdcbc02cf0f1ed9409" ;; \
        *) echo "No pinned cuDSS sha256 for ${CUDSS_VERSION} ${CUDA_ARCH_LABEL}/${CUDSS_SUFFIX}; update the checksum table." >&2; exit 1 ;; \
    esac && \
    curl -sL -o "${CUDSS_TARBALL}" "https://developer.download.nvidia.com/compute/cudss/redist/libcudss/linux-${CUDA_ARCH_LABEL}/${CUDSS_TARBALL}" && \
    echo "${CUDSS_SHA256}  ${CUDSS_TARBALL}" | sha256sum -c - && \
    tar -xJf "${CUDSS_TARBALL}" && \
    cp -r libcudss-*/lib/* /usr/local/lib/ && \
    cp -r libcudss-*/include/* /usr/local/include/ && \
    ldconfig && \
    rm -rf libcudss-* "${CUDSS_TARBALL}"

# Set up Python from manylinux image
# manylinux2014 has Python interpreters in /opt/python/cpXXX-cpXXX/
RUN PYTAG="cp${PYTHON_VERSION/./}" && \
    if [ -d "/opt/python/${PYTAG}-${PYTAG}" ]; then \
        ln -sf /opt/python/${PYTAG}-${PYTAG}/bin/python /usr/local/bin/python && \
        ln -sf /opt/python/${PYTAG}-${PYTAG}/bin/pip /usr/local/bin/pip; \
    else \
        echo "Python ${PYTHON_VERSION} not found, trying alternative paths..." && \
        ls -la /opt/python/ && \
        exit 1; \
    fi

# Verify Python version
RUN python --version && pip --version

# Install build dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install "nanobind>=2.11.0" scikit-build-core numpy auditwheel cmake

# Install PyTorch with CUDA support for torch bindings
# PYTORCH_INDEX is the PyTorch wheel index suffix (e.g., cu121, cu124)
RUN pip install torch --index-url https://download.pytorch.org/whl/${PYTORCH_INDEX}

# Install JAX with CUDA support for JAX FFI bindings
# CUDA_MAJOR is 12 or 13, giving jax[cuda12] or jax[cuda13]
RUN pip install "jax[cuda${CUDA_MAJOR}]"

WORKDIR /workspace
COPY . .

# Build the wheel from packages/moreau-cuda (without build isolation to use installed dependencies)
WORKDIR /workspace/packages/moreau-cuda
RUN pip wheel . -w dist_raw/ --no-deps --no-build-isolation

# Tag wheel as manylinux_2_28.
# libsodium is statically linked (see CMakeLists.txt), and all NVIDIA/CUDA libs
# are excluded — users get them via nvidia-* PyPI packages, and our __init__.py
# preloads them with ctypes.CDLL() before importing the C extension.
#
# We can't use auditwheel because it checks symbol versions of ALL linked
# libraries (even excluded ones), and NVIDIA libs require newer glibc than
# the manylinux tag. Since we have no vendored libs, just retag the wheel.
RUN python -m wheel tags --platform-tag "manylinux_2_28_${ARCH}" --remove dist_raw/*.whl && \
    mkdir -p dist && cp dist_raw/*.whl dist/

# Scrub source paths from binaries to prevent build environment leakage
RUN python scripts/scrub_binary.py dist/*.whl
# Strip Python comments from .py files in the wheel
RUN python /workspace/packages/moreau/scripts/scrub_python_wheel.py dist/*.whl

# Run the same release-wheel validator CI uses, so local builds fail fast
# on leaked build paths, SBOM files, etc. instead of only tripping in CI.
RUN python /workspace/scripts/validate_release_wheels.py dist/

# Show built wheels (version with +cuXXX suffix comes from pyproject.toml)
RUN echo "Built wheels:" && ls -la dist/

# Default command shows what was built
CMD ["ls", "-la", "/workspace/packages/moreau-cuda/dist/"]

# Minimal output stage: only the wheel file(s)
# Use with: docker build --target wheel-out --output type=local,dest=dist .
FROM scratch AS wheel-out
COPY --from=builder /workspace/packages/moreau-cuda/dist/*.whl /
